# Secreto de firma de los JWT. En desarrollo puede ser el de abajo; en
# producción tiene que ser un valor aleatorio de 32 bytes o más. Si el servidor
# arranca sin secreto (o con menos de 16 caracteres), el proxy bloquea TODAS las
# rutas con un 500 en vez de fallar abierto.
JWT_SECRET=shenzhenstock-dev-secret-change-me

# Vigencia del token. Acepta un número (segundos) o un sufijo s/m/h/d.
# Ojo: "7d" son 7 días. Un valor mal escrito cae en 7 días, no en error.
JWT_EXPIRES_IN=7d

# Carpeta del archivo de datos, relativa a process.cwd().
DATA_DIR=.data

# Conexión opcional a PostgreSQL. Si está presente, el servidor usa la capa
# `infrastructure/pg/` en vez del archivo JSON: el esquema se crea solo al
# arrancar y se siembra la tienda de ejemplo la primera vez.
# Levantar la base local: docker compose up -d
# (el contenedor publica el puerto 5433 para no chocar con un PostgreSQL nativo).
DATABASE_URL=postgresql://shenzhen:shenzhenstock-dev-password-change-me@localhost:5433/tienda

# development | production. En producción la cookie de sesión se marca
# `Secure`, así que el sitio debe servirse por HTTPS.
NODE_ENV=development
